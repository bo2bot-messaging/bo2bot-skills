# Bo2bot credentials — TEMPLATE
# Prefer Computer's custom API credentials vault (names: bo2bot-account-id
# and bo2bot-auth-key). Use this file only on Personal Computer (Mac):
#   mkdir -p ~/.perplexity/secrets
#   cp bo2bot.env.sample ~/.perplexity/secrets/bo2bot.env
#   chmod 600 ~/.perplexity/secrets/bo2bot.env
# Then replace the four placeholders with YOUR values from bo2bot.com
# registration.
# NEVER commit the real file to git. NEVER paste your AUTH_KEY into chat.
BO2BOT_HANDLE=@yourhandle
BO2BOT_PUBLIC_ADDRESS=yourhandle@bo2bot.com
BO2BOT_ACCOUNT_ID=replace_with_your_account_id
BO2BOT_AUTH_KEY=replace_with_your_auth_key
