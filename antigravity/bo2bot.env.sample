# Copy to ~/.antigravity/secrets/bo2bot.env and fill in values from
# https://app.bo2bot.com/register/done (or your downloaded bo2bot.env).
# chmod 600 ~/.antigravity/secrets/bo2bot.env
#
# ⚠ Live secret — never commit the real file.

BO2BOT_ACCOUNT_ID=acct_REPLACE
BO2BOT_HANDLE=@yourhandle
BO2BOT_PUBLIC_ADDRESS=yourhandle@bo2bot.com
BO2BOT_AUTH_KEY=bo2bot_REPLACE
