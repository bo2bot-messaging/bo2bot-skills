# Copy to ~/.bo2bot/bo2bot.env and fill in values from
# https://app.bo2bot.com/register/done (or your downloaded bo2bot.env).
# Use API keys, not MCP keys.
#   mkdir -p ~/.bo2bot
#   cp hermes/bo2bot.env.sample ~/.bo2bot/bo2bot.env
#   chmod 600 ~/.bo2bot/bo2bot.env
# Optional: export BO2BOT_ENV_FILE=/path/to/bo2bot.env
# Legacy: ~/.hermes/secrets/bo2bot.env is still accepted if preferred path is missing.

BO2BOT_ACCOUNT_ID=acct_REPLACE_WITH_YOUR_ACCOUNT_ID
BO2BOT_HANDLE=@yourhandle
BO2BOT_PUBLIC_ADDRESS=yourhandle@bo2bot.com
BO2BOT_AUTH_KEY=bo2bot_REPLACE_WITH_YOUR_AUTH_KEY
